@model DashboardViewModel
@{
    ViewData["Title"] = "Simulators";
}

<style>
    /* When the dashboard is in "latest only" mode, hide every result row except the newest. */
    #simulatorTabsContent.latest-only .result-not-latest {
        display: none;
    }
</style>

<div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Simulators</h1>
        <div class="text-muted small">
            Showing data as of @Model.AsOfUtc.ToString("u")
            · @Model.Simulators.Count simulator@(Model.Simulators.Count == 1 ? "" : "s") with results
        </div>
        <div class="mt-1">
            <span class="badge rounded-pill @(Model.ConnectedSimulatorCount > 0 ? "text-bg-success" : "text-bg-secondary")">
                @Model.ConnectedSimulatorCount connected
            </span>
            <span class="text-muted small ms-1">(responded to discovery poll)</span>
        </div>
    </div>

    <div class="btn-toolbar gap-2" role="toolbar" aria-label="Dashboard controls">
        <div class="btn-group" role="group" aria-label="Result display mode">
            <button type="button" id="showAll" class="btn btn-sm btn-primary active">All results</button>
            <button type="button" id="showLatest" class="btn btn-sm btn-outline-primary">Latest only</button>
        </div>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index" title="Reload latest data from the simulators">
            Refresh
        </a>
    </div>
</div>

@if (Model.IsEmpty)
{
    <div class="alert alert-info" role="alert">
        No simulators are reporting yet.
    </div>
}
else
{
    <ul class="nav nav-tabs" id="simulatorTabs" role="tablist">
        @for (var i = 0; i < Model.Simulators.Count; i++)
        {
            var sim = Model.Simulators[i];
            var tabId = $"sim-{sim.Id:N}";
            var isActive = i == 0;

            <li class="nav-item" role="presentation">
                <button class="nav-link @(isActive ? "active" : "")"
                        id="@(tabId)-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#@tabId"
                        type="button"
                        role="tab"
                        aria-controls="@tabId"
                        aria-selected="@(isActive ? "true" : "false")">
                    <span class="font-monospace">@sim.ShortId</span>
                    @if (sim.IsStale)
                    {
                        <span class="badge text-bg-warning ms-1" title="No new output for noticeably longer than this simulator's normal output frequency">stale</span>
                    }
                </button>
            </li>
        }
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom p-3" id="simulatorTabsContent" data-dashboard-content>
        @for (var i = 0; i < Model.Simulators.Count; i++)
        {
            var sim = Model.Simulators[i];
            var tabId = $"sim-{sim.Id:N}";
            var isActive = i == 0;

            <div class="tab-pane fade @(isActive ? "show active" : "")"
                 id="@tabId"
                 role="tabpanel"
                 aria-labelledby="@(tabId)-tab"
                 tabindex="0">
                <partial name="_SimulatorPanel" model="sim" />
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        // "Latest only" vs "All results" is a pure view toggle - it hides/shows already-loaded
        // rows and never contacts the server. Only "Refresh" fetches fresh data.
        (function () {
            const content = document.getElementById('simulatorTabsContent');
            const showAll = document.getElementById('showAll');
            const showLatest = document.getElementById('showLatest');

            if (!content || !showAll || !showLatest) {
                return;
            }

            function setMode(latestOnly) {
                content.classList.toggle('latest-only', latestOnly);

                showLatest.classList.toggle('btn-primary', latestOnly);
                showLatest.classList.toggle('btn-outline-primary', !latestOnly);
                showLatest.classList.toggle('active', latestOnly);

                showAll.classList.toggle('btn-primary', !latestOnly);
                showAll.classList.toggle('btn-outline-primary', latestOnly);
                showAll.classList.toggle('active', !latestOnly);
            }

            showAll.addEventListener('click', () => setMode(false));
            showLatest.addEventListener('click', () => setMode(true));
        })();
    </script>
}
