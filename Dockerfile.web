FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["BeggarMyNeighbourWeb/BeggarMyNeighbourWeb.csproj", "BeggarMyNeighbourWeb/"]
COPY ["BeggarMyNeighbourLibrary/BeggarMyNeighbourLibrary.csproj", "BeggarMyNeighbourLibrary/"]
RUN dotnet restore "BeggarMyNeighbourWeb/BeggarMyNeighbourWeb.csproj"
COPY . .
WORKDIR "/src/BeggarMyNeighbourWeb"
RUN dotnet build "BeggarMyNeighbourWeb.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "BeggarMyNeighbourWeb.csproj" -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=publish /app/publish .
# Listen on 8080 inside the container (non-privileged; the ASP.NET image default for .NET 8+).
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "BeggarMyNeighbourWeb.dll"]
